---
/* A still: a black-and-white photograph with a one-line caption. Decorative, so the image has no alt text. */
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { imageSizes } from '../book-layout'

interface Props {
  src: ImageMetadata
  caption?: string
  /** "tall" is 420×560 on a spread, "square" is 200×200. */
  size: 'tall' | 'square'
  class?: string
}
const { src, caption, size, class: extra } = Astro.props
const sizes = size === 'tall' ? imageSizes(30) : imageSizes(14, 52)
---

<figure class:list={['still', `still-${size}`, extra]}>
  <Image src={src} alt="" widths={size === 'tall' ? [480, 840] : [240, 420, 640]} sizes={sizes} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
