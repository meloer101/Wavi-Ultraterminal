---
/* One plate: an app screen drawn in Figma (W10), with "Plate 0n" and its caption underneath. On phones a tap opens it
   full screen. "bleed-r" / "bleed-l" run off the spread's outer edge (680 wide); "detail" is a small crop with a
   one-line caption. */
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { imageSizes } from '../book-layout'
import type { Plate } from '../i18n'

interface Props {
  src: ImageMetadata
  plate: Plate
  n: number
  word: string
  /** "full" spans both pages (1088), "half" sits on one page (600), "bleed-*" (680) and "detail" (560) are crops. */
  size: 'full' | 'half' | 'bleed-r' | 'bleed-l' | 'detail'
  eager?: boolean
}
const { src, plate, n, word, size, eager = false } = Astro.props
const vw = { full: 76, half: 42, 'bleed-r': 47, 'bleed-l': 47, detail: 39 }[size]
const nn = String(n).padStart(2, '0')
---

<figure class={`plate plate-${size}`}>
  <Image src={src} alt={plate.alt} widths={[700, 1100, 1600, 2200]} sizes={imageSizes(vw)} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} data-zoomable />
  {size === 'detail' ? (
    <figcaption class="still-cap">{word} {nn} — {plate.caption}</figcaption>
  ) : (
    <figcaption>
      <span class="plate-n">{word} {nn}</span>
      <span class="plate-cap">{plate.caption}</span>
    </figcaption>
  )}
</figure>
