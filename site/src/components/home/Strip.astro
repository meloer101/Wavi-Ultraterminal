---
/* Screen 2: the nineteen agent CLIs Wavi starts, each with its own mark, on their own paper screen. */
import { AGENT_NAMES, AGENT_ORDER } from '../../agent-marks'
import { copy, type Lang } from '../../i18n'
import AgentMark from './AgentMark.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = copy[lang]
---

<section class="screen section-paper wall">
  <div class="wrap">
    <h2 class="wall-title">{t.strip}</h2>
    <ul class="wall-list">
      {AGENT_ORDER.map((id, i) => (
        <li data-reveal style={`--i:${i}`}><AgentMark id={id} /><span>{AGENT_NAMES[id]}</span></li>
      ))}
    </ul>
  </div>
</section>
