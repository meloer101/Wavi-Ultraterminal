---
/* The five board status glyphs, 14×14 in `currentColor`. Shape as well as the words, so a status never rides on
   colour alone. */
import { CHECK_PATH } from './check-path'

export type GlyphKind = 'needs' | 'error' | 'review' | 'running' | 'idle'

interface Props {
  kind: GlyphKind
}
const { kind } = Astro.props
---

<span class="glyph" aria-hidden="true">
  <svg viewBox="0 0 14 14">
    {kind === 'needs' && <circle cx="7" cy="7" r="4.5" fill="currentColor" />}
    {kind === 'error' && (
      <>
        <path d="M7 1.8 12.6 11.8H1.4L7 1.8Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        <path d="M7 5.6v3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        <circle cx="7" cy="10" r="0.7" fill="currentColor" />
      </>
    )}
    {kind === 'review' && (
      <path d={CHECK_PATH} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    )}
    {kind === 'running' && (
      <path d="M12 7a5 5 0 1 1-2.2-4.15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    )}
    {kind === 'idle' && (
      <circle cx="7" cy="7" r="4.25" fill="none" stroke="currentColor" stroke-opacity="0.6" stroke-width="1.4" />
    )}
  </svg>
</span>
