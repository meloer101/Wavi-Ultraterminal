---
/* FAQ: four <details>, the first open, so the page shows everything with JavaScript off. */
import { copy, type Lang } from '../../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = copy[lang]
---

<section class="section section-light faq">
  <div class="wrap faq-row">
    <div class="faq-left">
      <p class="label label-brand">{t.faq.label}</p>
      <h2 class="display-s">{t.faq.title}</h2>
    </div>
    <div class="faq-list">
      {t.faq.items.map(({ q, a }, i) => (
        <details open={i === 0}>
          <summary><span>{q}</span><span class="faq-plus" aria-hidden="true"></span></summary>
          <p class="faq-a">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
