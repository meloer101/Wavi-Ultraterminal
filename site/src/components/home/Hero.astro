---
/* The hero: the two headline lines (the one serif italic word inside), the sub, the two buttons, and the dotted
   cradle art in the rest of the first screen. Nav + hero are one viewport; the art is 1/0.7 of the leftover space,
   centred and cut by the hero's lower edge, or capped at 96vw and then bottom-anchored. */
import { Image } from 'astro:assets'
import { pic } from '../../home-art'
import { copy, type Lang } from '../../i18n'
import Ctas from '../Ctas.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = copy[lang]
---

<section class="hero">
  <div class="wrap hero-content">
    <h1>
      {t.hero.title.map(([before, em, after], i) => (
        <span class="hero-line" data-hero style={`--i:${i}`}>
          {before}
          {em ? <em>{em}</em> : null}
          {after}
        </span>
      ))}
    </h1>
    <p class="hero-sub" data-hero style="--i:2">{t.hero.sub[0]}<br />{t.hero.sub[1]}</p>
    <div class="hero-actions" data-hero style="--i:3">
      <Ctas download={t.hero.download} github={t.hero.github} />
    </div>
  </div>
  <div class="hero-art" aria-hidden="true">
    <div class="hero-art-media">
      <Image src={pic(lang, 'hero-cradle.png')} widths={[960, 1920]} sizes="96vw" loading="eager" fetchpriority="high" alt="" />
    </div>
  </div>
</section>
