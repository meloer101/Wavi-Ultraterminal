---
/* The site as a magazine (Figma W10): twelve spreads on wide screens, nineteen single pages on phones.
   Each <section data-spread> is one spread; its .page children are the phone pages, except where data-merge
   keeps the spread as one phone page. scripts/book.ts turns them; without it they simply stack and scroll.
   Five chapters: I Board, II Ensemble (two spreads and a plate), III Threads, IV Ship (a spread and the chain), V Wardrobe. */
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import mirror from '../assets/magazine/still-mirror.webp'
import windows from '../assets/magazine/still-windows.webp'
import { copy, otherPath, roman, type Lang } from '../i18n'
import { gh, withBase } from '../site'
import Ctas from './Ctas.astro'
import Items from './Items.astro'
import Plate from './Plate.astro'
import Still from './Still.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = copy[lang]
const art = import.meta.glob<{ default: ImageMetadata }>('../assets/magazine/{en,zh}-*.webp', { eager: true })
const pic = (name: string): ImageMetadata => {
  const hit = art[`../assets/magazine/${lang}-${name}.webp`]
  if (!hit) throw new Error(`missing plate image ${lang}-${name}.webp`)
  return hit.default
}
const two = (n: number): string => String(n).padStart(2, '0')
/** Plate n (1-based): its image, copy and number. */
const plate = (n: number) => ({ src: pic(`plate-${two(n)}`), plate: t.plates[n - 1], n, word: t.plateWord })
/** Where each chapter starts, and where each plate is printed: page number and the spread it sits on. */
const chapterAt: [string, string][] = [['04', 'board'], ['08', 'hand'], ['14', 'threads'], ['16', 'ship'], ['20', 'wardrobe']]
const plateAt: [string, string][] = [['01', 'cover'], ['06', 'plate-02'], ['09', 'hand'], ['10', 'plate-04'], ['12', 'teams'], ['12', 'teams'], ['14', 'threads'], ['17', 'ship'], ['18', 'chain'], ['21', 'wardrobe']]
const download = gh('/releases/latest')
---

<main id="main" class="book" data-book>
  <div class="board" data-board>
    <header class="bar">
      <a class="bar-mark" href="#cover" aria-label={t.bar.home}>WAVI</a>
      <nav aria-label={t.bar.label}>
        <a class="bar-section" href="#board">{t.bar.board}</a>
        <a class="bar-section" href="#hand">{t.bar.ensemble}</a>
        <a class="bar-section" href="#threads">{t.bar.threads}</a>
        <a class="bar-section" href="#ship">{t.bar.ship}</a>
        <a class="bar-section" href="#wardrobe">{t.bar.wardrobe}</a>
        <a href={download} rel="noopener">{t.bar.download}</a>
        <a href={withBase(otherPath(lang))} hreflang={lang === 'en' ? 'zh-CN' : 'en'} aria-label={t.bar.otherLabel}>{t.bar.other}</a>
      </nav>
    </header>

    <section class="spread duo cover" id="cover" data-spread data-merge>
      <div class="page l">
        <p class="kicker">{t.cover.kicker}</p>
        <h1 class="title">{t.cover.title[0]}<br />{t.cover.title[1]}</h1>
        <p class="sub">{t.cover.sub}</p>
        <Ctas download={t.cover.download} github={t.cover.github} />
        <p class="folio folio-l">{t.issue}</p>
      </div>
      <div class="page r">
        <Plate {...plate(1)} size="half" eager />
        <p class="folio folio-r">01</p>
      </div>
    </section>

    <section class="spread duo index" id="contents" data-spread>
      <div class="page l">
        <h2 class="label">{t.contents.label}</h2>
        <ol class="toc toc-chapters">
          {t.contents.chapters.map(([numeral, name, line], i) => (
            <li>
              <a href={`#${chapterAt[i][1]}`}>
                <span class="toc-look">{numeral}</span>
                <span class="toc-name">{name}<span class="toc-line">{line}</span></span>
                <span class="toc-page">{chapterAt[i][0]}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="folio folio-l">02</p>
      </div>
      <div class="page r">
        <h2 class="label">{t.contents.plates}</h2>
        <ol class="toc toc-plates">
          {t.plates.map((p, i) => (
            <li>
              <a href={`#${plateAt[i][1]}`}>
                <span class="toc-look">{t.plateWord} {two(i + 1)}</span>
                <span class="toc-name">{p.name}</span>
                <span class="toc-page">{plateAt[i][0]}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="folio folio-r">03</p>
      </div>
    </section>

    <section class="spread duo status" id="board" data-spread>
      <div class="page l inset" data-center>
        <Still src={windows} caption={t.board.still} size="tall" />
        <p class="folio folio-l">04</p>
      </div>
      <div class="page r">
        <p class="label">{t.board.label}</p>
        <h2 class="display">{t.board.title}</h2>
        <p class="body body-lead">{t.board.body}</p>
        <Items items={t.board.items} />
        <p class="folio folio-r">05</p>
      </div>
    </section>

    <section class="spread full plate-spread" id="plate-02" data-spread>
      <div class="page full" data-center>
        <Plate {...plate(2)} size="full" />
        <p class="folio folio-r">06 — 07</p>
      </div>
    </section>

    <section class="spread duo ensemble hand" id="hand" data-spread>
      <div class="page l">
        <p class="label">{t.hand.label}</p>
        <h2 class="display">{t.hand.title[0]}<br />{t.hand.title[1]}</h2>
        <Items items={t.hand.items} />
        <p class="folio folio-l">08</p>
      </div>
      <div class="page r wide bleed" data-center>
        <Plate {...plate(3)} size="bleed-r" />
        <p class="folio folio-r">09</p>
      </div>
    </section>

    <section class="spread full plate-spread" id="plate-04" data-spread>
      <div class="page full" data-center>
        <Plate {...plate(4)} size="full" />
        <p class="folio folio-r">10 — 11</p>
      </div>
    </section>

    <section class="spread duo ensemble teams" id="teams" data-spread>
      <div class="page l wide bleed" data-center>
        <Plate {...plate(5)} size="bleed-l" />
        <Plate {...plate(6)} size="detail" />
        <p class="folio folio-l">12</p>
      </div>
      <div class="page r">
        <p class="label">{t.hand.label}</p>
        <h2 class="display">{t.teams.title[0]}<br />{t.teams.title[1]}</h2>
        <Items items={t.teams.items} />
        <p class="folio folio-r">13</p>
      </div>
    </section>

    <section class="spread duo windows" id="threads" data-spread>
      <div class="page l wide" data-center>
        <Plate {...plate(7)} size="half" />
        <div class="still-row">
          <Still src={mirror} size="square" />
          <p class="still-cap">{t.threads.still}</p>
        </div>
        <p class="folio folio-l">14</p>
      </div>
      <div class="page r">
        <p class="label">{t.threads.label}</p>
        <h2 class="display">{t.threads.title[0]}<br />{t.threads.title[1]}</h2>
        <Items items={t.threads.items} />
        <p class="folio folio-r">15</p>
      </div>
    </section>

    <section class="spread duo ship" id="ship" data-spread>
      <div class="page l wide bleed" data-center>
        <Plate {...plate(8)} size="bleed-l" />
        <p class="folio folio-l">16</p>
      </div>
      <div class="page r">
        <p class="label">{t.ship.label}</p>
        <h2 class="display">{t.ship.title[0]}<br />{t.ship.title[1]}</h2>
        <Items items={t.ship.items} />
        <p class="folio folio-r">17</p>
      </div>
    </section>

    <section class="spread full chain" id="chain" data-spread>
      <div class="page full">
        <h2 class="display">{t.chain.title}</h2>
        <ol class="chain-steps">
          {t.chain.steps.map((step, i) => (
            <li>
              <span class="num">{roman(i).toLowerCase()}.</span>
              <h3 class="item-title">{step}</h3>
              <Image src={pic(`step${i + 1}`)} alt={step} widths={[480, 740]} sizes="(min-width: 900px) 17vw, 45vw" loading="lazy" data-zoomable />
            </li>
          ))}
        </ol>
        <p class="plate-caption">
          <span class="plate-n">{t.plateWord} 09</span>
          <span class="plate-cap">{t.plates[8].caption}</span>
        </p>
        <p class="folio folio-r">18 — 19</p>
      </div>
    </section>

    <section class="spread duo wardrobe" id="wardrobe" data-spread>
      <div class="page l">
        <p class="label">{t.wardrobe.label}</p>
        <h2 class="display">{t.wardrobe.title[0]}<br />{t.wardrobe.title[1]}</h2>
        <Items items={t.wardrobe.items} />
        <p class="folio folio-l">20</p>
      </div>
      <div class="page r wide" data-center>
        <figure class="plate plate-tiles">
          <ol class="tiles">
            {t.wardrobe.tiles.map((label, i) => (
              <li>
                <Image src={pic(`tile${i + 1}`)} alt={label} widths={[580, 870]} sizes="(min-width: 900px) 21vw, 45vw" loading="lazy" data-zoomable />
                <span class="still-cap">{label}</span>
              </li>
            ))}
          </ol>
          <figcaption>
            <span class="plate-n">{t.plateWord} 10</span>
            <span class="plate-cap">{t.plates[9].caption}</span>
          </figcaption>
        </figure>
        <p class="folio folio-r">21</p>
      </div>
    </section>

    <section class="spread full finale" id="finale" data-spread>
      <div class="page full back" data-center>
        <p class="wordmark" aria-hidden="true">WAVI</p>
        <Ctas download={t.cover.download} github={t.cover.github} class="ctas-end" />
        <p class="colophon">{t.colophon}</p>
        <p class="folio folio-l">22</p>
        <p class="folio folio-r">23</p>
      </div>
    </section>
  </div>
</main>

<dialog class="zoom" data-zoom>
  <form method="dialog"><button class="zoom-close">{t.zoom.close}</button></form>
</dialog>

<script>
  import '../scripts/book'
</script>
