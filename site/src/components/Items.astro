---
/* Numbered features: "(I)" over an italic title over one line of text. */
import { roman, type Item } from '../i18n'

interface Props {
  items: Item[]
}
---

<ol class="items">
  {Astro.props.items.map(([title, body], i) => (
    <li>
      <span class="num">({roman(i)})</span>
      <h3 class="item-title">{title}</h3>
      <p class="body">{body}</p>
    </li>
  ))}
</ol>
